# LLM provider selection.
# Use "mock" for zero-configuration local verification.
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# Runtime mode and file locations.
SIMULATOR_PROVIDER=mock
SCENE_CONFIG_PATH=config/scene.json
GROUND_TRUTH_PATH=config/ground_truth.json
OUTPUT_DIR=output

# Harness closed-loop settings.
MAX_REPLAN_ATTEMPTS=3
FAILURE_RATE_THRESHOLD=0.25

# Mock simulator probabilities (independent, not additive)
MOCK_SUCCESS_PROBABILITY=1.00
MOCK_TIMEOUT_PROBABILITY=0.00
MOCK_CONFLICT_PROBABILITY=0.00

# Deterministic seed for repeatable mock runs. Leave empty for random behavior.
MOCK_RANDOM_SEED=42
