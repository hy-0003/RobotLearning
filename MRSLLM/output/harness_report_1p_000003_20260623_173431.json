          "code": "def robot_behavior(robot_state, world_state):\n    # 操作 op_7 [0,53] 工位 loc_7 工件 wp_2\n    if robot_state.last_time < 0:\n        wait(0)\n    move(\"loc_7\", 5.0)\n    operate(\"task_execution\", \"wp_2\", \"loc_7\")\n\n    # 操作 op_4 [53,151] 工位 loc_4 工件 wp_1\n    if robot_state.last_time < 53:\n        wait(53 - robot_state.last_time)\n    move(\"loc_4\", 5.0)\n    operate(\"task_execution\", \"wp_1\", \"loc_4\")\n\n    # 操作 op_6 [151,217] 工位 loc_6 工件 wp_1\n    if robot_state.last_time < 151:\n        wait(151 - robot_state.last_time)\n    move(\"loc_6\", 5.0)\n    operate(\"task_execution\", \"wp_1\", \"loc_6\")",
